{
  "title": "Canton LocalNet — DApp Developer Overview",
  "schemaVersion": 39,
  "version": 1,
  "uid": "canton-localnet-v1",
  "tags": ["canton", "splice", "localnet"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, instance)",
        "refresh": 1,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ledger TPS (5m avg)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(daml_participant_api_indexer_updates{instance=~\"$instance\"}[5m]))",
          "legendFormat": "tx/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Participants",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "count(up{component=\"canton\", instance=~\"$instance\"} == 1)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sequencer Submission Latency (p95)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB Connections (in use)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(db_client_connections_usage{state=\"used\", instance=~\"$instance\"})" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Transactions per Second",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(daml_participant_api_indexer_updates{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM Heap Used (per node)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{jvm_memory_type=\"heap\", instance=~\"$instance\"}",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sequencer Block Event Rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(daml_sequencer_block_events_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Submission Sequencing Latency",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, component))",
          "legendFormat": "p50 {{component}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, component))",
          "legendFormat": "p95 {{component}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Active Contract Set Size",
      "description": "Total active contracts across participants. Uses `daml_services_index_active_contracts` (Daml participant indexer gauge). If your Canton image does not expose this metric, the panel will read 'No data' — there is no audited stock-metric fallback on Splice 0.6.4, so prefer the Web UI Explorer / JSON API ACS lookup instead.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(daml_services_index_active_contracts{instance=~\"$instance\"})",
          "legendFormat": "active contracts"
        }
      ]
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Top 10 Templates by Throughput (ops/s, 5m)",
      "description": "Top templates ranked by command-submission rate. Uses `daml_commands_submissions_total` aggregated by `template_id`. Requires Canton/Daml to expose the `template_id` label on the submissions counter — on Splice 0.6.4 stock images this label may be absent, in which case the panel renders as a single aggregate bar or no data. Treat this as a best-effort panel until upstream template-grain metrics are guaranteed.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (template_id) (rate(daml_commands_submissions_total{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{template_id}}"
        }
      ]
    }
  ]
}
