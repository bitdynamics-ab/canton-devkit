{
  "title": "Canton LocalNet — DApp Developer Overview",
  "schemaVersion": 39,
  "version": 1,
  "uid": "canton-localnet-v1",
  "tags": ["canton", "splice", "localnet"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up, instance)",
        "refresh": 1,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ledger TPS (5m avg)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(daml_participant_api_indexer_updates{instance=~\"$instance\"}[5m])) or vector(0)",
          "legendFormat": "tx/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Participants",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "count(up{component=\"canton\", instance=~\"$instance\"} == 1)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sequencer Submission Latency (p95)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB Connections (in use)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(db_client_connections_usage{state=\"used\", instance=~\"$instance\"})" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Transactions per Second",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(daml_participant_api_indexer_updates{instance=~\"$instance\"}[1m]) or vector(0)",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM Heap Used (per node)",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{jvm_memory_type=\"heap\", instance=~\"$instance\"}",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Sequencer Block Event Rate",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "rate(daml_sequencer_block_events_total{instance=~\"$instance\"}[1m])",
          "legendFormat": "{{component}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Submission Sequencing Latency",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, component))",
          "legendFormat": "p50 {{component}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(daml_sequencer_client_submissions_sequencing_duration_seconds_bucket{instance=~\"$instance\"}[5m])) by (le, component))",
          "legendFormat": "p95 {{component}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "ACS Lookup Buffer Length",
      "description": "ACS-related index lookup buffer length across participants. Stock Splice 0.6.4 does not expose total active-contract cardinality as a Prometheus metric; use the Web UI Explorer / JSON API ACS lookup for exact active contract counts.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "sum(daml_participant_api_index_db_active_contract_lookup_batch_buffer_length{instance=~\"$instance\"})",
          "legendFormat": "ACS lookup buffer"
        }
      ]
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Top 10 gRPC Methods by Throughput (ops/s, 5m)",
      "description": "Command/API throughput by live gRPC method. Stock Splice 0.6.4 does not expose template-grain submission counters, so this panel uses the audited `daml_grpc_server_handled_total` method label instead of a non-existent template metric.",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (grpc_method_name) (rate(daml_grpc_server_handled_total{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{grpc_method_name}}"
        }
      ]
    }
  ]
}
