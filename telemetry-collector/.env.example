# Copy to .env and fill in. docker compose reads .env automatically.

# Postgres superuser password. Generate a strong one:
#   openssl rand -hex 24
POSTGRES_PASSWORD=changeme

# Optional shared secret for ingest auth. When set, the CLI must send it
# in the X-Telemetry-Token header (you'd bake it into release builds, or
# set it via CANTON_DEVKIT_TELEMETRY_TOKEN if/when the CLI supports a
# token header). Leave empty for loopback/VPN-only deployments.
INGEST_TOKEN=
