# Build artifacts
bin/
dist/

# Local environment
.env
.env.*
!.env.example

# OS/editor files
.DS_Store
.idea/
.vscode/

# Agent runtime state
.claude/scheduled_tasks.lock

# Vite/React build output for the embedded Web UI. The placeholder
# index.html is tracked so go:embed has at least one match on a
# fresh clone; `make frontend` overwrites it with the real bundle.
# See internal/ui/assets.go.
internal/ui/dist/*
!internal/ui/dist/index.html
.worktrees/
