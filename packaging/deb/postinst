#!/bin/sh
set -e

case "$1" in
  configure)
    # Best-effort install-surface telemetry. The binary owns opt-out
    # precedence (DO_NOT_TRACK / DPM_TELEMETRY), local spooling, and upload
    # timeouts. Never fail package installation if telemetry is disabled or
    # the collector is unavailable.
    if command -v canton-devkit >/dev/null 2>&1; then
      canton-devkit telemetry _record-install-surface apt >/dev/null 2>&1 || true
    fi
    ;;
esac

exit 0
